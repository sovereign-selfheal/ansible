---
# Template of group_vars/all/vault.yml. That file is NOT tracked by git (.gitignore):
# keep it on your machine, encrypted with ansible-vault.
#
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml     # choose a vault password
#   ansible-vault edit group_vars/all/vault.yml        # set the values
#   ansible-playbook playbooks/site.yml --ask-vault-pass
#
# On RHDP, AgnosticV passes the same variables as extra vars: no vault file is needed.

# External "SOTA" model of the router (OpenAI compatible).
sota_api_base: https://provider.example.com/v1
sota_model: openai/example-model
sota_served_match: example-model
sota_api_key: sk-REPLACE_ME

# C2 classifier of the privacy gate. The default (classifier_mode: local in main.yml) uses
# the local model and needs nothing here. For an external classifier:
# classifier_mode: external
# classifier_base_url: https://provider.example.com/v1
# classifier_model: example-classifier
# classifier_api_key: sk-REPLACE_ME

# Team access (roles/team_access): personal logins with cluster-admin rights, see README "Team access".
# The usernames stay here, not in git. The password is the initial one: Keycloak asks for a new
# one at the first login. An empty list (the default) turns team access off.
# team_users:
#   - username: alice
#     password: REPLACE_ME
#   - username: bob
#     password: REPLACE_ME
#
# Keycloak master admin, only when the Secret keycloak/keycloak-initial-admin is out of date:
# keycloak_admin_username: admin
# keycloak_admin_password: REPLACE_ME
