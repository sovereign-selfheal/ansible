---
# Tempo multi-tenancy (openshift mode): the Tempo gateway lets a writer send traces to a tenant
# only with this cluster-scoped permission. The gitops repo deploys the collector (ServiceAccount
# {{ service_account }} in {{ namespace }}) and the TempoMonolithic with the same tenant name.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: tempo-traces-write-{{ tenant }}
rules:
  - apiGroups: [tempo.grafana.com]
    resources: ["{{ tenant }}"]
    resourceNames: [traces]
    verbs: [create]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: tempo-traces-write-{{ tenant }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: tempo-traces-write-{{ tenant }}
subjects:
  - kind: ServiceAccount
    name: {{ service_account }}
    namespace: {{ namespace }}
