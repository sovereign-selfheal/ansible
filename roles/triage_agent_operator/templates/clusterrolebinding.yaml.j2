apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ triage_agent_operator_name }}
  labels:
    app: {{ triage_agent_operator_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ triage_agent_operator_name }}
subjects:
  - kind: ServiceAccount
    name: {{ triage_agent_operator_name }}
    namespace: {{ triage_agent_operator_namespace }}
